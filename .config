# ====================== 1. 目标架构（IPQ60xx + NSS）======================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re_cs7=y

# NSS 核心加速（必须，千兆满速）
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunip=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunip6=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan=y
CONFIG_PACKAGE_kmod-qca-nss-ecm-bridge=y
CONFIG_PACKAGE_kmod-qca-nss-ecm-nat=y
CONFIG_PACKAGE_kmod-qca-mcs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y

# ====================== 2. 双宽带负载均衡 MWAN3 ======================
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y

# ====================== 3. 策略路由 PBR（分流核心）======================
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_pbr=y
CONFIG_PACKAGE_luci-i18n-pbr-zh-cn=y

# ====================== 4. DNS 优化 MosDNS ======================
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y

# ====================== 5. 代理插件（OpenClash + Nikki 二选一/都要）======================
# OpenClash
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_openclash=y
# Nikki（轻量代理）
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_nikki=y

# ====================== 6. 基础 LuCI + 中文 ======================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-wireless=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_LUCI_LANG_zh-cn=y

# ====================== 7. 常用工具 ======================
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-statistics=y

# USB 存储/共享
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_usbutils=y

# 网络工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ping=y
CONFIG_PACKAGE_traceroute=y
CONFIG_PACKAGE_nload=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_nlbwmon=y

# ====================== 8. 依赖/内核模块 ======================
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-ipt-ipset=y

# ====================== 9. 关闭无用（减小体积）======================
# CONFIG_PACKAGE_luci-app-adguardhome is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set
