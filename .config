# ==============================
# 终极锁定机型：在线升级不报错
# ==============================
CONFIG_TARGET_BOARD="qualcommax"
CONFIG_TARGET_DEVICE_STRING="qualcommax ipq60xx jdcloud_re-cs-07"

# ==============================
# 设备：京东云 RE-CS-07
# ==============================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-07=y

# ==============================
# 内核 6.6 + NSS ECM 硬件加速
# ==============================
CONFIG_LINUX_6_6=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-ifb=y
CONFIG_PACKAGE_kmod-qca-nss-qdisc=y

# ==============================
# BTF + BPF（dae 必备）
# ==============================
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_NET_INGRESS=y
CONFIG_NET_EGRESS=y

# ==============================
# 双宽带：MWAN3 + mwan3help
# ==============================
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3help=y
CONFIG_PACKAGE_luci-app-mwan3help=y

# ==============================
# dae + daed 面板
# ==============================
CONFIG_PACKAGE_dae=y
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_v2ray-geodata=y

# ==============================
# AdGuardHome 去广告
# ==============================
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y

# ==============================
# MosDNS 智能解析
# ==============================
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y

# ==============================
# OpenClash 代理
# ==============================
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y

# ==============================
# KMS 激活服务
# ==============================
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y

# ==============================
# 全套主题
# ==============================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-argon-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-bootstrap-zh-cn=y
CONFIG_PACKAGE_luci-theme-material=y
CONFIG_PACKAGE_luci-i18n-material-zh-cn=y
CONFIG_PACKAGE_luci-theme-openwrt-2020=y
CONFIG_PACKAGE_luci-i18n-openwrt-2020-zh-cn=y
CONFIG_PACKAGE_luci-theme-alpha=y
CONFIG_PACKAGE_luci-i18n-alpha-zh-cn=y

# ==============================
# 基础必备工具
# ==============================
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iproute2=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_usb-storage=y
